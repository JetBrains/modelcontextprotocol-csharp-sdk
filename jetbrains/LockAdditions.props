<Project>
  <!--
    Packages the fork needs that are not part of the main solution lock.
    Every package here must be available from the configured package sources at the exact version.
    Only versions whose dependencies are already satisfied by the main solution lock are acceptable here.
  -->
  <ItemGroup>
    <!-- Published JetBrains repack of MEAI 9.10.2 without the net9.0 asset. -->
    <PackageLock Include="JetBrains.Microsoft.Extensions.AI.Abstractions" Version="9.10.2.5" />
  </ItemGroup>
</Project>
