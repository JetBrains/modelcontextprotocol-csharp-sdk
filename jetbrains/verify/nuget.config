<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Where jetbrains/build.sh puts the fork packages. -->
    <add key="fork" value="../../artifacts/jetbrains/packages" />
    <add key="dotnet_build_space" value="https://cache-redirector.jetbrains.com/nuget-build/v3/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Replaces the mapping of the upstream nuget.config, which this file inherits otherwise. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="fork">
      <package pattern="JetBrains.ModelContextProtocol.*" />
    </packageSource>
    <packageSource key="dotnet_build_space">
      <package pattern="JetBrains.Microsoft.Extensions.AI.Abstractions" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
